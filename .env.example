# Copy this file to .env and adjust the local values.
# Never use example values in production.

# Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchpad?schema=public

# Server
PORT=5000
NODE_ENV=development

# Authentication (use two different random secrets outside local development)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Vite frontend
FRONTEND_URL=http://localhost:5173

# Optional integrations — configure only when using the related feature
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@launchpad.cm
RESEND_FROM_NAME=Launchpad
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_ENVIRONMENT=sandbox
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
OPENAI_API_KEY=
